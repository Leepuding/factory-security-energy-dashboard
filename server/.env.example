# MySQL must be available before phase 2 upload persistence is enabled.
DATABASE_URL=mysql+pymysql://document_demo:change-me@127.0.0.1:3306/document_analysis
UPLOAD_DIR=./server/data/uploads
REPORT_DIR=./server/data/reports
DAILY_PARSE_LIMIT=20
# Use mock when no external model is configured.
AI_PROVIDER=mock
# DeepSeek uses an OpenAI-compatible API. Remove the leading # lines below
# and set AI_PROVIDER=openai_compatible to enable it on the server.
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=replace-with-your-deepseek-key
# AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_RETRY_COUNT=1
AI_ENABLE_EMBEDDING=false
